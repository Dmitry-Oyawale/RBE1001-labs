{"mode":"Text","hardwareTarget":"brain","textContent":"#region VEXcode Generated Robot Configuration\nfrom vex import *\nimport urandom\nimport math\n\n# Brain should be defined by default\nbrain=Brain()\n\n# Robot configuration code\nright_motor = Motor(Ports.PORT1, GearSetting.RATIO_18_1, True)\nleft_motor = Motor(Ports.PORT2, GearSetting.RATIO_18_1, False)\ninertial_sensor = Inertial(Ports.PORT3)\nrange_finder_front = Sonar(brain.three_wire_port.e)\nrange_finder_right = Sonar(brain.three_wire_port.c)\n# AI Vision Color Descriptions\n# AI Vision Code Descriptions\nai_vision_15 = AiVision(Ports.PORT15, AiVision.ALL_TAGS)\n\n\n# wait for rotation sensor to fully initialize\nwait(30, MSEC)\n\n\n# Make random actually random\ndef initializeRandomSeed():\n    wait(100, MSEC)\n    random = brain.battery.voltage(MV) + brain.battery.current(CurrentUnits.AMP) * 100 + brain.timer.system_high_res()\n    urandom.seed(int(random))\n      \n# Set random seed \ninitializeRandomSeed()\n\n\ndef play_vexcode_sound(sound_name):\n    # Helper to make playing sounds from the V5 in VEXcode easier and\n    # keeps the code cleaner by making it clear what is happening.\n    print(\"VEXPlaySound:\" + sound_name)\n    wait(5, MSEC)\n\n# add a small delay to make sure we don't print in the middle of the REPL header\nwait(200, MSEC)\n# clear the console to make sure we don't have the REPL in the console\nprint(\"\\033[2J\")\n\n#endregion VEXcode Generated Robot Configuration\n# ------------------------------------------\n# \n# \tProject:      VEXcode Project\n#\tAuthor:       VEX\n#\tCreated:\n#\tDescription:  VEXcode V5 Python Project\n# \n# ------------------------------------------\n\n# Library imports\nfrom vex import *\n\nKp_distance = 5\nKp_angle = 1\ncenterDistanceInches = 5\ncenterX = 160\nfruitHeightPixels = 150\n\nobjects = ai_vision_15.take_snapshot(AiVision.ALL_TAGS)\n\n\n# Begin project code\n\ndef clamp(mn, mx, val):\n    return max(mn, min(val, mx))\n\ndef drive(speed, direction):\n   left_motor.set_velocity(speed + direction, RPM)\n   right_motor.set_velocity(speed - direction, RPM)\n   left_motor.spin(REVERSE)\n   right_motor.spin(REVERSE)\n\nwheelDiameter = 4.25\nwheelCircumference = math.pi * wheelDiameter\ngearRatio = 5.0\nKp = 22\n\ndef driveStraight(motorVoltage, distanceInInches):\n    distanceDriven = 0.0\n\n    while (True):\n        if (distanceDriven > distanceInInches):\n            break\n    \n        leftPosition, rightPosition = left_motor.position(TURNS), right_motor.position(TURNS)\n        avgPosition = (leftPosition + rightPosition)/2\n        \n        error = leftPosition - rightPosition\n        left_voltage = max(-12, min(motorVoltage - Kp * error, 12))\n        right_voltage = max(-12, min(motorVoltage + Kp * error, 12))\n        distanceDriven = (avgPosition/gearRatio) * wheelCircumference\n\n        left_motor.spin(REVERSE, left_voltage, VOLT)\n        right_motor.spin(REVERSE, right_voltage, VOLT)\n        wait(10, MSEC)\n    left_motor.stop()\n    right_motor.stop()\n\n\ndef turn_in_place(angleDegrees):\n    global Kp_angle\n    initialHeading = inertial_sensor.heading(DEGREES) #inertial_sensor.heading(DEGREES) if inertial_sensor.heading(DEGREES) <= 180 else 360 - inertial_sensor.heading(DEGREES)\n    finalHeading = (initialHeading + angleDegrees) % 360\n    print(\"Final heading: \", finalHeading)\n    print(\"Initial heading: \", initialHeading)\n    currentHeading = initialHeading\n    wait(10, MSEC)\n    while (True):\n        currentHeading = inertial_sensor.heading(DEGREES) #inertial_sensor.heading(DEGREES) if inertial_sensor.heading(DEGREES) <= 180 else 360 - inertial_sensor.heading(DEGREES)\n        error = ((currentHeading - finalHeading + 180) % 360) - 180\n        print(\"Current heading: \", currentHeading)\n        print(\"Error: \", error)\n        if (math.fabs(error) < 1):\n            break\n        left_voltage = max(-6, min(Kp_angle * error, 6))\n        right_voltage = max(-6, min(Kp_angle * error, 6))\n        left_motor.spin(FORWARD, left_voltage, VOLT)\n        right_motor.spin(REVERSE, right_voltage, VOLT)\n        wait(10, MSEC)\n\n\ndef FindAprilElement(ID):\n    global objects\n\n    for element in range(6):\n\n        if(objects[element].id == ID):\n            return element\n\n    return -1\n\n\nAprilElement = -1\nCurrentID = 37\n\ndef DetectObject():\n    global objects\n  # takes a snapshot and searches for Orange_Fr\n  # you’ll want to use the signature that you defined above\n\n    objects = ai_vision_15.take_snapshot(AiVision.ALL_TAGS)\n\n    # print the coordinates of the center of the object\n    if (objects[0].exists == True):\n        AprilElement = FindAprilElement(CurrentID)\n\n        if (AprilElement > -1):\n            print(\"object detected\")\n            global centerX, fruitHeightPixels, Kp_angle, Kp_distance\n            tag = objects[AprilElement]\n            angleError = tag.centerX - centerX\n            distanceError = fruitHeightPixels - tag.height\n            print(\"Angle error: \", angleError, \" Speed: \", Kp_distance * distanceError * 1)\n            print(\"Distance error: \", distanceError, \" Direction: \", Kp_angle * angleError)\n            drive(Kp_distance * distanceError * 0.12, Kp_angle * angleError * 0.2)\n            wait(90, MSEC)\n            return True\n        else:\n            print(\"Could not find tag\")\n            left_motor.stop()\n            right_motor.stop()\n            return False\n    else:\n        print(\"could not find tag\")\n        left_motor.stop()\n        right_motor.stop()\n        return False\n    \n\n\n\n# MAIN\nwait(5, SECONDS)\ndrive(200, 0)\nwait(3, SECONDS)\nwhile (math.fabs(0 - inertial_sensor.orientation(OrientationType.ROLL, DEGREES)) > 1):\n    distance = range_finder_right.distance(INCHES)\n    error = distance - centerDistanceInches\n    drive(150, Kp_distance*error)\n    wait(40, MSEC)\ndrive(200, 0)\nwait(1.5, SECONDS)\nturn_in_place(-90)\ndrive(150, 0)\nwait(3.8, SECONDS)\nwhile (DetectObject()):\n    wait(10, MSEC)\ndrive(100,0)\nwait(0.5,SECONDS)\nleft_motor.stop()\nright_motor.stop()\n\n","textLanguage":"python","robotConfig":[{"port":[1],"name":"right_motor","customName":true,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"true","fwd":"forward","rev":"reverse","gear":"ratio18_1"},"triportSourcePort":22},{"port":[2],"name":"left_motor","customName":true,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"false","fwd":"forward","rev":"reverse","gear":"ratio18_1"},"triportSourcePort":22},{"port":[3],"name":"inertial_sensor","customName":true,"deviceType":"Inertial","deviceClass":"inertial","setting":{},"triportSourcePort":22},{"port":[5,6],"name":"range_finder_front","customName":true,"deviceType":"RangeFinder","deviceClass":"sonar","setting":{},"triportSourcePort":22},{"port":[3,4],"name":"range_finder_right","customName":true,"deviceType":"RangeFinder","deviceClass":"sonar","setting":{},"triportSourcePort":22},{"port":[15],"name":"ai_vision_15","customName":false,"deviceType":"AIVision","deviceClass":"aivision","setting":{"config":"{\"colors\":[],\"codes\":[],\"tags\":true,\"AIObjects\":false,\"AIObjectModel\":[\"Ball(Blue)\",\"Ball(Green)\",\"Ball(Red)\",\"Ring(Blue)\",\"Ring(Green)\",\"Ring(Red)\",\"Cube(Blue)\",\"Cube(Green)\",\"Cube(Red)\"],\"AIModelMetadata\":{\"id\":0,\"version\":1,\"name\":\"Classroom Objects\"},\"aiModelDropDownValue\":0}","isConfigured":"false"},"triportSourcePort":22}],"slot":1,"platform":"V5","sdkVersion":"20240802.15.00.00","appVersion":"4.64.0","fileFormat":"2.0.0","targetBrainGen":"First","v5Sounds":[{"name":"game over","url":"static/sounds/mixkit-arcade-retro-game-over-213.wav"}],"v5SoundsEnabled":false,"aiVisionSettings":{"colors":[],"codes":[],"tags":true,"AIObjects":true,"AIObjectModel":[],"aiModelDropDownValue":null}}