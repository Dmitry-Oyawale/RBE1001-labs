{"mode":"Text","hardwareTarget":"brain","textContent":"#region VEXcode Generated Robot Configuration\nfrom vex import *\nimport urandom\nimport math\n\n# Brain should be defined by default\nbrain=Brain()\n\n# Robot configuration code\nright_motor = Motor(Ports.PORT1, GearSetting.RATIO_18_1, False)\nleft_motor = Motor(Ports.PORT2, GearSetting.RATIO_18_1, True)\nline_tracker_right = Line(brain.three_wire_port.a)\nline_tracker_left = Line(brain.three_wire_port.b)\nrange_finder = Sonar(brain.three_wire_port.c)\n# AI Vision Color Descriptions\nai_vision_9__GREEN_Fr = Colordesc(1, 51, 207, 100, 15, 0.33)\nai_vision_9__COLOR2 = Colordesc(2, 209, 55, 51, 5, 0.37)\nai_vision_9__COLOR3 = Colordesc(3, 97, 48, 121, 18, 0.32)\n# AI Vision Code Descriptions\nai_vision_9 = AiVision(Ports.PORT9, ai_vision_9__GREEN_Fr, ai_vision_9__COLOR2, ai_vision_9__COLOR3, AiVision.ALL_TAGS)\narm_motor = Motor(Ports.PORT3, GearSetting.RATIO_18_1, True)\ninertial_sensor = Inertial(Ports.PORT12)\ngripper_motor = Motor(Ports.PORT8, GearSetting.RATIO_18_1, False)\ncontroller_1 = Controller(PRIMARY)\nbump_left = Bumper(brain.three_wire_port.f)\nrange_finder_right = Sonar(brain.three_wire_port.g)\nbump_right = Bumper(brain.three_wire_port.e)\n\n\n# wait for rotation sensor to fully initialize\nwait(30, MSEC)\n\n\n# Make random actually random\ndef initializeRandomSeed():\n    wait(100, MSEC)\n    random = brain.battery.voltage(MV) + brain.battery.current(CurrentUnits.AMP) * 100 + brain.timer.system_high_res()\n    urandom.seed(int(random))\n      \n# Set random seed \ninitializeRandomSeed()\n\n\ndef play_vexcode_sound(sound_name):\n    # Helper to make playing sounds from the V5 in VEXcode easier and\n    # keeps the code cleaner by making it clear what is happening.\n    print(\"VEXPlaySound:\" + sound_name)\n    wait(5, MSEC)\n\n# add a small delay to make sure we don't print in the middle of the REPL header\nwait(200, MSEC)\n# clear the console to make sure we don't have the REPL in the console\nprint(\"\\033[2J\")\n\n\n\n# define variables used for controlling motors based on controller inputs\ncontroller_1_up_down_buttons_control_motors_stopped = True\ncontroller_1_x_b_buttons_control_motors_stopped = True\n\n# define a task that will handle monitoring inputs from controller_1\ndef rc_auto_loop_function_controller_1():\n    global controller_1_up_down_buttons_control_motors_stopped, controller_1_x_b_buttons_control_motors_stopped, remote_control_code_enabled\n    # process the controller input every 20 milliseconds\n    # update the motors based on the input values\n    while True:\n        if remote_control_code_enabled:\n            # check the buttonUp/buttonDown status\n            # to control arm_motor\n            if controller_1.buttonUp.pressing():\n                arm_motor.spin(FORWARD)\n                controller_1_up_down_buttons_control_motors_stopped = False\n            elif controller_1.buttonDown.pressing():\n                arm_motor.spin(REVERSE)\n                controller_1_up_down_buttons_control_motors_stopped = False\n            elif not controller_1_up_down_buttons_control_motors_stopped:\n                arm_motor.stop()\n                # set the toggle so that we don't constantly tell the motor to stop when\n                # the buttons are released\n                controller_1_up_down_buttons_control_motors_stopped = True\n            # check the buttonX/buttonB status\n            # to control gripper_motor\n            if controller_1.buttonX.pressing():\n                gripper_motor.spin(FORWARD)\n                controller_1_x_b_buttons_control_motors_stopped = False\n            elif controller_1.buttonB.pressing():\n                gripper_motor.spin(REVERSE)\n                controller_1_x_b_buttons_control_motors_stopped = False\n            elif not controller_1_x_b_buttons_control_motors_stopped:\n                gripper_motor.stop()\n                # set the toggle so that we don't constantly tell the motor to stop when\n                # the buttons are released\n                controller_1_x_b_buttons_control_motors_stopped = True\n        # wait before repeating the process\n        wait(20, MSEC)\n\n# define variable for remote controller enable/disable\nremote_control_code_enabled = True\n\nrc_auto_loop_thread_controller_1 = Thread(rc_auto_loop_function_controller_1)\n\n#endregion VEXcode Generated Robot Configuration\n\n# ------------------------------------------\n# \n# \tProject:      VEXcode Project\n#\tAuthor:       VEX\n#\tCreated:\n#\tDescription:  VEXcode V5 Python Project\n# \n# ------------------------------------------\n\n# Library imports\nfrom vex import *\n\n\nKp_angle_hanging = 1\nKp_distance_hangin = 0.5\nKp_hanging = 10\n\nsideDistance = 4.6\nsideEnd = 50\nnumBeyondThreshold = 0\n\n\ndef turn_in_place_right(angleDegrees):\n    global Kp_angle\n    initialHeading = inertial_sensor.heading(DEGREES) #inertial_sensor.heading(DEGREES) if inertial_sensor.heading(DEGREES) <= 180 else 360 - inertial_sensor.heading(DEGREES)\n    finalHeading = (initialHeading + angleDegrees) % 360\n    #print(\"Final heading: \", finalHeading)\n    #print(\"Initial heading: \", initialHeading)\n    currentHeading = initialHeading\n    wait(10, MSEC)\n    while (True):\n        currentHeading = inertial_sensor.heading(DEGREES) #inertial_sensor.heading(DEGREES) if inertial_sensor.heading(DEGREES) <= 180 else 360 - inertial_sensor.heading(DEGREES)\n        error = ((currentHeading - finalHeading + 180) % 360) - 180\n       # print(\"Current heading: \", currentHeading)\n       # print(\"Error: \", error)\n        if (math.fabs(error) < 1):\n            break\n        left_voltage = max(-6, min(Kp_angle * error, 6))\n        right_voltage = max(-6, min(Kp_angle * error, 6))\n        left_motor.spin(REVERSE, left_voltage, VOLT)\n        right_motor.spin(FORWARD, right_voltage, VOLT)\n        wait(10, MSEC)\n\n\n\ndef drive(speed, direction):\n   left_motor.set_velocity(speed + direction, RPM)\n   right_motor.set_velocity(speed - direction, RPM)\n   left_motor.spin(FORWARD)\n   right_motor.spin(FORWARD)\n\ndef driveBackwards(speed, direction):\n   left_motor.set_velocity(speed - direction, RPM)\n   right_motor.set_velocity(speed + direction, RPM)\n   left_motor.spin(REVERSE)\n   right_motor.spin(REVERSE)\n\ndef trackLine2(): #On platform to bottom of ramp\n    global state\n    left_percent, right_percent = line_tracker_left.reflectivity(PERCENT), line_tracker_right.reflectivity(PERCENT)\n    print(\"Left:\", left_percent, \"Right:\", right_percent)\n    if (left_percent > 40 and right_percent > 40 and state == DRIVE): # both line trackers are on a line so turn 90 degrees\n        state = DESCENT\n        print(\"DESCENT\")\n        left_motor.spin_for(FORWARD, 1000, DEGREES, wait=False)\n        right_motor.spin_for(FORWARD, 1000, DEGREES, wait=True)\n        turn_in_place_right(-90)\n        left_motor.spin_for(REVERSE, 3000, DEGREES, wait=False)\n        right_motor.spin_for(REVERSE, 3000, DEGREES, wait=True)\n    elif (left_percent < 40):\n        drive(150, 10)\n    elif (right_percent < 40):\n        drive(150, -10)\n    else:\n        drive(150, 0)\n\ndef trackLine3(): #bottom of ramp to bar \n    left_percent, right_percent = line_tracker_left.reflectivity(PERCENT), line_tracker_right.reflectivity(PERCENT)\n    if (left_percent < 40):\n        drive(40, 50)\n    elif (right_percent < 40):\n        drive(40, -50)\n    else:\n        drive(150, 0)\n\ndef checkDistance():\n    print(range_finder.distance(INCHES))\ncontroller_1.buttonR1.pressed(checkDistance)\n\ndef checkDistanceSide():\n    print(range_finder_right.distance(INCHES))\ncontroller_1.buttonL1.pressed(checkDistanceSide)\n\n\n\n### STATES ###\nIDLE = -1\nDRIVING_UP_RAMP = 0\nLOOKING_FOR_FRUIT = 1\nDRIVING_TO_FRUIT = 2\nPICKING_FRUIT = 3\nHOLDING_FRUIT = 4\nDELIVERING_FRUIT = 5\nDRIVNG_DOWN_RAMP = 6\nDRIVING_TO_BAR = 7\nHANGING = 8\n\n## Hanging States\nDRIVE = 100\nTURN = 200\nDESCENT = 300\nREORIENT1 = 400\nREORIENT2 = 500\nREORIENT3 = 600\nFINAL_APPROACH = 700\nHANG = 800\n\nGRIPPER_OPEN = 9\nGRIPPER_CLOSED = 10\n\nARM_HOME = 11\nARM_LOW_FRUIT = 12\nARM_HIGH_FRUIT = 13\nARM_VISION_HEIGHT = 23\n\n### CONSTANTS ###\ncolors = [ai_vision_9__COLOR2, ai_vision_9__GREEN_Fr, ai_vision_9__COLOR3]\nbin_tags = [20, 21, 22, 23]\n\ncenterX = 160\nfruitHeightPixels = 140\nfruitWidthPixels = 210\n\ntagWidthPixels = 60\ntagHeightPixels = 50\n\nKp_angle = 2\nKp_distance = 0.4\n\nwheelDiameter = 4.25\nwheelCircumference = math.pi * wheelDiameter\ngearRatio = 5.0\nKp = 20\n\n### GLOBAL VARIABLES ###\nfruit_objs = []\ntag_objs = []\nidx = 0\n\nstate = DRIVING_UP_RAMP\ngripper_state = GRIPPER_CLOSED\narm_state = ARM_HOME\n\n\ndef driveStraight(motorVoltage, distanceInInches):\n    distanceDriven = 0.0\n    left_motor.set_position(0,DEGREES)\n    right_motor.set_position(0,DEGREES)\n    while (True):\n        if (distanceDriven > distanceInInches):\n            break\n    \n        leftPosition, rightPosition = left_motor.position(TURNS), right_motor.position(TURNS)\n        avgPosition = (leftPosition + rightPosition)/2\n        \n        error = leftPosition - rightPosition\n        left_voltage = max(-12, min(motorVoltage - Kp * error, 12))\n        right_voltage = max(-12, min(motorVoltage + Kp * error, 12))\n        distanceDriven = math.fabs((avgPosition/gearRatio) * wheelCircumference)\n        left_motor.spin(FORWARD, left_voltage, VOLT)\n        right_motor.spin(FORWARD, right_voltage, VOLT)\n        wait(10, MSEC)\n    left_motor.stop()\n    right_motor.stop()\n\ndef back_off_inches(inches, volts=4.0):\n    print(\"backing off\")\n    driveStraight(-abs(volts), abs(inches))\n\n\ndef trackLine():\n    left_percent, right_percent = line_tracker_left.reflectivity(PERCENT), line_tracker_right.reflectivity(PERCENT)\n    if (left_percent < 40):\n        drive(150, 10)\n    elif (right_percent < 40):\n        drive(150, -10)\n    else:\n        drive(150, 0)\n\n\ndef bump_wall():\n    return bump_left.pressing() or bump_right.pressing()\n\ndef line_on():\n    left_p  = line_tracker_left.reflectivity(PERCENT)\n    right_p = line_tracker_right.reflectivity(PERCENT)\n    return (left_p < 40) or (right_p < 40)\n\ndef acquire_line(max_attempts=6):\n    for _ in range(max_attempts):\n        t0 = brain.timer.time(MSEC)\n        drive(120, 0)\n\n        while brain.timer.time(MSEC) - t0 < 900:\n            if line_on():\n                stop_robot()\n                return True\n            if bump_wall():\n                stop_robot()\n                return True\n            wait(20, MSEC)\n\n        stop_robot()\n        turn_in_place(30)\n\n    return False\n\n\ndef stop_robot():\n    left_motor.stop()\n    right_motor.stop()\n    print(\"stopped robot\")\n\ndef turn_in_place(angleDegrees):\n    global Kp_angle\n    initialHeading = inertial_sensor.heading(DEGREES)# if inertial_sensor.heading(DEGREES) <= 180 else 360 - inertial_sensor.heading(DEGREES)\n    finalHeading = (initialHeading + angleDegrees) % 360\n    #print(\"Final heading: \", finalHeading)\n    #print(\"Initial heading: \", initialHeading)\n    #print(\"error: \", (((initialHeading - finalHeading + 180) % 360) - 180))\n    currentHeading = initialHeading\n    wait(10, MSEC)\n    while (True):\n        currentHeading = inertial_sensor.heading(DEGREES)# if inertial_sensor.heading(DEGREES) <= 180 else 360 - inertial_sensor.heading(DEGREES)\n        error = -(((currentHeading - finalHeading + 180) % 360) - 180)\n        #print(\"Current heading: \", currentHeading)\n        #print(\"Error: \", error)\n        if (math.fabs(error) < 2):\n            stop_robot()\n            wait(50, MSEC)\n            break\n        left_voltage = max(-6, min(Kp_angle * error, 6))\n        right_voltage = max(-6, min(Kp_angle * error, 6))\n        left_motor.spin(FORWARD, left_voltage, VOLT)\n        right_motor.spin(REVERSE, right_voltage, VOLT)\n        wait(10, MSEC)\n\ndef turn_to_heading(target_heading):\n    while (True):\n        current = inertial_sensor.heading(DEGREES)\n        error = target_heading - current\n\n        if abs(error) <= 2:\n            stop_robot()\n            break\n\n        voltage = max(-6, min(Kp_angle * error, 6))\n        left_motor.spin(FORWARD,  voltage, VOLT)\n        right_motor.spin(REVERSE, voltage, VOLT)\n        wait(10, MSEC)\n    stop_robot()\n\ndef turn_relative(deg):\n    return turn_to_heading((inertial_sensor.heading(DEGREES) + deg) % 360)\n\ndef get_fruit(color):\n    global fruit_objs\n    fruit_objs = ai_vision_9.take_snapshot(color)\n    return fruit_objs\n\ndef get_tags():\n    global tag_objs\n    tag_objs = ai_vision_9.take_snapshot(AiVision.ALL_TAGS)\n    return tag_objs\n\ndef check_arm_outside_bounds():\n    return arm_motor.position(TURNS) < -7 or arm_motor.position(TURNS) > 0.3\ndef move_arm_to_bounds():\n    if (arm_motor.position(TURNS) < -7):\n        arm_motor.spin_to_position(-4.9,TURNS,wait=True)\n    else:\n         arm_motor.spin_to_position(-0.1,TURNS,wait=True)\n\ndef getTagIndex(objects, id):\n    i = 0\n    for tag in objects:\n        if (tag.id == id):\n            return i\n        i = i + 1\n    return -1\n\ndef containsTag(lst, tag_id):\n    for tag in lst:\n        if tag.id == tag_id:\n            return True\n    return False\n\ndef drive_to_fruit(color):\n    global fruit_objs, centerX, Kp_distance, centerY, fruitWidthPixels, colors\n    get_fruit(colors[idx])\n    if (len(fruit_objs) > 0):\n        fruit = fruit_objs[0]\n        if (fruit.width < 220):\n            angleError = fruit.centerX - centerX\n            distanceError = fruit.width - fruitWidthPixels\n            drive(100 - (Kp_distance * distanceError), Kp_angle * angleError)\n            wait(50, MSEC)\n            return 0\n        else:\n            stop_robot()\n            return 1\n         \n    else:\n        stop_robot()\n        return 1\n\ndef drive_to_tag(id):\n    global tag_objs, centerX, Kp_distance, centerY, fruitWidthPixels\n    get_tags()\n    idx = getTagIndex(tag_objs, id)\n\n    if (tag_objs[idx].exists == True):\n        tag = tag_objs[idx]\n        if (tag.height < 57):\n            angleError = tag.centerX - centerX\n            distanceError = tag.height - tagWidthPixels\n            drive(100 - (Kp_distance * distanceError), 0.5 * Kp_angle * angleError)\n            wait(50, MSEC)\n            return 0\n        else:\n            stop_robot()\n            return 1   \n    else:\n        stop_robot()\n        return 1\n\n# use to align robot to wall\ndef normalize_to_wall(fail_time=3000):\n    t0 = brain.timer.time(MSEC)\n    drive(80, 0)\n    while not bump_wall():\n        if brain.timer.time(MSEC) - t0 > fail_time:\n            stop_robot()\n            print(\"timed out\")\n            return False\n        wait(10, MSEC)\n    stop_robot()\n    print(\"bumped wall\")\n    t1 = brain.timer.time(MSEC)\n    while brain.timer.time(MSEC) - t1 < fail_time/2:\n        if bump_left.pressing() and bump_right.pressing():\n            print(\"success\")\n            stop_robot()\n            print(\"robot is stopepd\")\n            return True\n\n        if bump_left.pressing() and not bump_right.pressing():\n            right_motor.spin(FORWARD, 8.0, VOLT)\n            left_motor.spin(REVERSE, 8.0, VOLT)\n            #left_motor.stop()\n        elif bump_right.pressing() and not bump_left.pressing():\n            right_motor.spin(REVERSE, 8.0, VOLT)\n            #right_motor.stop()\n            left_motor.spin(FORWARD, 8.0, VOLT)\n        else:\n            drive(150, 0)\n\n        wait(20, MSEC)\n\n    stop_robot()\n    return True#bump_left.pressing() and bump_right.pressing()\n\n#snapshot_fn - use get_fruit or get_tags\n#found_fn - use to check if list has any useful objects\n#example _ sweep_search(get_tags, containsTag)\ndef sweep_search(snapshot_fn, found_fn, sweep_deg=40, step_deg=10, timeout_ms=2500):\n    base = inertial_sensor.heading(DEGREES)\n    t0 = brain.timer.time(MSEC)\n\n    while brain.timer.time(MSEC) - t0 < timeout_ms:\n        lst = snapshot_fn()\n        if found_fn(lst):\n            return True\n\n        for k in range(1, int(sweep_deg/step_deg) + 1):\n            turn_in_place(2*(k*step_deg))\n            wait(50, MSEC)\n            lst = snapshot_fn()\n            if found_fn(lst):\n                return True\n\n            turn_in_place(-1*(k*step_deg))\n            wait(50, MSEC)\n            lst = snapshot_fn()\n            if found_fn(lst):\n                return True\n\n    turn_to_heading(180)\n    return False\n\ndef align_to_bin_tag(bin_tag_id=23):\n    # turn_to_heading(180)\n    # if not normalize_to_wall(10000):\n    #     print(\"failed normalize\")\n    #     return False\n    # print(\"backing off\")\n    # back_off_inches(8, volts=6.0)\n    gotoVisionHeight()\n\n    # sweep to find tag\n    get_tags()\n    if not containsTag(tag_objs, bin_tag_id):\n        print(\"sweeping\")\n        found = sweep_search(get_tags, lambda lst: containsTag(lst, bin_tag_id), sweep_deg=30, step_deg=10, timeout_ms=8000)\n        if not found:\n            print(\"could not find fruit\")\n            return False\n\n    # drive towards bin\n    t0 = brain.timer.time(MSEC)\n    while brain.timer.time(MSEC) - t0 < 5000:\n        if drive_to_tag(bin_tag_id):\n            stop_robot()\n            break\n        wait(20, MSEC)\n\n    # final normalization to wall\n    #turn_to_heading(180)\n    drive(60, 0)\n    wait(500, MSEC)\n    stop_robot()\n    normalize_to_wall(6000)\n\n    return True\n\ndef adjust_gripper():\n    global gripper_state, GRIPPER_CLOSED, GRIPPER_OPEN\n    if (gripper_state == GRIPPER_OPEN):\n        print(\"closing gripper\")\n        gripper_motor.spin_to_position(0,DEGREES,wait=True)\n        gripper_motor.stop(BRAKE)\n        gripper_state = GRIPPER_CLOSED\n    else:\n        gripper_motor.spin_to_position(330,DEGREES,wait=True)\n        print(\"opening gripper\")\n        gripper_state = GRIPPER_OPEN\n\ndef open_gripper():\n    if (gripper_state == GRIPPER_CLOSED):\n        adjust_gripper()\n\ndef close_gripper():\n    if (gripper_state == GRIPPER_OPEN):\n        adjust_gripper()\n\ndef gotoLowBranch():\n    global arm_state\n    if(not arm_state == ARM_LOW_FRUIT):\n        arm_state = ARM_LOW_FRUIT\n        arm_motor.spin_to_position(-2.6,TURNS,wait=True)\n\ndef gotoHighBranch():\n    global arm_state\n    if(not arm_state == ARM_HIGH_FRUIT):\n        arm_state = ARM_HIGH_FRUIT\n        arm_motor.spin_to_position(-7, TURNS, wait=True)\n\ndef gotoHome():\n    global arm_state\n    if(not arm_state == ARM_HOME):\n        arm_state = ARM_HOME\n        arm_motor.spin_to_position(0, TURNS, wait=True)\n\ndef gotoVisionHeight():\n    global arm_state\n    if(not arm_state == ARM_VISION_HEIGHT):\n        arm_state = ARM_VISION_HEIGHT\n        arm_motor.spin_to_position(-2.2, TURNS, wait=True)\n\n\n# inertial_sensor.calibrate()\n# wait(2, SECONDS)\n# #turn_in_place(90)\n\n# open_gripper()\n# gotoLowBranch()\n\n# while(not drive_to_fruit(ai_vision_9__COLOR2)):\n#     pass\n\n# close_gripper()\n# gotoHome()\n# turn_in_place(60)\n# gotoVisionHeight()\n\n# while(not drive_to_tag(23)):\n#     pass \n\n# open_gripper()\n\n\ninertial_sensor.calibrate()\nwait(5,SECONDS)\ngotoVisionHeight()\n#turn_in_place(-30)\ndriveStraight(12, 6)\nstate = DRIVING_UP_RAMP\n## MAIN ###\nwhile (True):\n    if (state == DRIVING_UP_RAMP):\n        print(\"ramp\")\n        gotoVisionHeight()\n        print(inertial_sensor.orientation(OrientationType.ROLL,DEGREES))\n        if (math.fabs(0 - inertial_sensor.orientation(OrientationType.ROLL, DEGREES)) > 1):\n            trackLine()\n        else:\n            driveStraight(6, 19)\n            stop_robot()\n            turn_in_place(-90)\n            back_off_inches(6, volts=6.0)\n            state = LOOKING_FOR_FRUIT\n    \n\n    if (state == LOOKING_FOR_FRUIT):\n        print(\"looking for fruit\")\n        if (idx <= 1):\n            gotoVisionHeight()\n        else:\n            gotoHighBranch()\n        objects = get_fruit(colors[idx])\n        if (len(objects) == 0):\n            #trackLine()\n            sweep_search(lambda: get_fruit(colors[idx]), lambda lst: len(lst) > 0, sweep_deg=150, step_deg=30, timeout_ms=10000)\n        else:\n            stop_robot()\n            state = DRIVING_TO_FRUIT\n\n    if(state == DRIVING_TO_FRUIT):\n        #print(\"driving to fruit\")\n        if (idx <= 1):\n            gotoLowBranch()\n        else:\n            gotoHighBranch()\n        open_gripper()\n        if(drive_to_fruit(colors[idx])):\n            stop_robot()\n            driveStraight(12, 0.5)\n            close_gripper()\n            if (idx == 2):\n                back_off_inches(10, volts=4)\n                gotoHome()\n                driveStraight(8, 4)\n            else:\n                gotoHome()\n            # could be turn to see rather than fixed angle\n            turn_to_heading(190)\n            gotoVisionHeight()\n            state = HOLDING_FRUIT\n    \n    if (state == HOLDING_FRUIT):\n        print(\"holding fruit\")\n        # if(drive_to_tag(23)):\n        #     stop_robot()\n        #     open_gripper()\n        #     gotoHome()\n        #     # turn_in_place(90)\n        #     state = LOOKING_FOR_FRUIT\n        if align_to_bin_tag(20):\n            stop_robot()\n            open_gripper()\n            wait(200, MSEC)\n            \n\n            # next cycle\n            idx += 1\n            print(\"IDX: \", idx)\n            if(idx > 2):\n                print(\"Starting climgbing\")\n                state = DRIVE # climb stuff happens here\n                turn_in_place_right(-90)\n            else:\n                back_off_inches(10, volts=4.0)\n                gotoHome()\n                turn_to_heading(10)\n                state = LOOKING_FOR_FRUIT\n                back_off_inches(25, volts=6.0)\n\n        \n    if(state == DRIVE):\n        print(\"Yippee!!!!!!\")\n        trackLine2()\n\n    if(state == DESCENT):\n        print(\"Descent!\")\n        distance = range_finder_right.distance(INCHES)\n        error = sideDistance - distance\n        driveBackwards(50, error * Kp_distance) #negative left, positive right\n        if (range_finder_right.distance(INCHES) > 30):\n            state = REORIENT1\n            print(\"TURN\")\n            turn_in_place_right(-90)\n            left_motor.spin_for(FORWARD, 300, DEGREES,wait=False)\n            right_motor.spin_for(FORWARD, 300, DEGREES,wait=True)\n        \n        #print(\"Direction: \" + str(error * Kp_distance) + \"\\nDistance: \" + str(distance))\n        wait(50, MSEC)\n\n    if(state == REORIENT1):\n        left_percent = line_tracker_left.reflectivity(PERCENT)\n        drive(150, -20)\n        if(left_percent > 40):\n            state = REORIENT2\n        wait(50, MSEC)\n\n    if(state == REORIENT2):\n        print(\" Reorient 2\")\n        right_percent = line_tracker_right.reflectivity(PERCENT)\n        drive(150, 0)\n        if(right_percent > 40):\n            state = FINAL_APPROACH\n        wait(50, MSEC)\n\n    if(state == FINAL_APPROACH):\n        trackLine3()\n        if(range_finder.distance(INCHES) < 12.5):\n            state = HANG\n\n    if(state == HANG):\n        left_motor.stop()\n        right_motor.stop()\n        print(\"Hanging now\")\n        arm_motor.spin_for(REVERSE, 1900, DEGREES, wait=True)\n        print(\"1\")\n        #left_motor.spin_for(REVERSE, 1000, DEGREES, wait=False)\n        #right_motor.spin_for(REVERSE, 1000, DEGREES, wait=True)\n        arm_motor.spin_for(FORWARD, 2600, DEGREES, wait=False)\n        left_motor.set_velocity(150, RPM)\n        right_motor.set_velocity(150, RPM)\n        left_motor.spin_for(REVERSE, 2000, DEGREES, wait=False)\n        print(\"backing up\")\n        right_motor.spin_for(REVERSE, 2000, DEGREES, wait=False)\n        arm_motor.set_stopping(BRAKE)\n        break\n    \n\n# left_motor.stop()\n# right_motor.stop()\n# print(\"Hanging now\")\n# armMotor.spin_for(FORWARD, 1900, DEGREES, wait=True)\n# armMotor.spin_for(REVERSE, 2600, DEGREES, wait=False)\n# left_motor.set_velocity(150, RPM)\n# right_motor.set_velocity(150, RPM)\n# left_motor.spin_for(REVERSE, 2000, DEGREES, wait=False)\n# print(\"backing up\")\n# right_motor.spin_for(REVERSE, 2000, DEGREES, wait=False)","textLanguage":"python","robotConfig":[{"port":[1],"name":"right_motor","customName":true,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"false","fwd":"forward","rev":"reverse","gear":"ratio18_1"},"triportSourcePort":22},{"port":[2],"name":"left_motor","customName":true,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"true","fwd":"forward","rev":"reverse","gear":"ratio18_1"},"triportSourcePort":22},{"port":[1],"name":"line_tracker_right","customName":true,"deviceType":"LineTracker","deviceClass":"line","setting":{},"triportSourcePort":22},{"port":[2],"name":"line_tracker_left","customName":true,"deviceType":"LineTracker","deviceClass":"line","setting":{},"triportSourcePort":22},{"port":[3,4],"name":"range_finder","customName":true,"deviceType":"RangeFinder","deviceClass":"sonar","setting":{},"triportSourcePort":22},{"port":[9],"name":"ai_vision_9","customName":false,"deviceType":"AIVision","deviceClass":"aivision","setting":{"config":"{\"colors\":[{\"id\":1,\"name\":\"GREEN_Fr\",\"nameValid\":\"Valid\",\"lastValidName\":\"GREEN_Fr\",\"red\":51.351851851851855,\"green\":206.66545893719805,\"blue\":99.77334943639292,\"hueRange\":15,\"saturationRange\":0.33},{\"id\":2,\"name\":\"COLOR2\",\"nameValid\":\"Valid\",\"lastValidName\":\"COLOR2\",\"red\":209.02693244065733,\"green\":55.19872185027389,\"blue\":50.62439135727328,\"hueRange\":5,\"saturationRange\":0.37},{\"id\":3,\"name\":\"COLOR3\",\"nameValid\":\"Valid\",\"lastValidName\":\"COLOR3\",\"red\":97.33451171011932,\"green\":47.56175430844012,\"blue\":120.53419133893063,\"hueRange\":18,\"saturationRange\":0.32}],\"codes\":[],\"tags\":true,\"AIObjects\":false,\"AIObjectModel\":[\"Ball(Blue)\",\"Ball(Green)\",\"Ball(Red)\",\"Ring(Blue)\",\"Ring(Green)\",\"Ring(Red)\",\"Cube(Blue)\",\"Cube(Green)\",\"Cube(Red)\"],\"AIModelMetadata\":{\"id\":0,\"version\":1,\"name\":\"Classroom Objects\"},\"aiModelDropDownValue\":0}","isConfigured":"false"},"triportSourcePort":22},{"port":[3],"name":"arm_motor","customName":true,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"true","fwd":"forward","rev":"reverse","gear":"ratio18_1"},"triportSourcePort":22},{"port":[12],"name":"inertial_sensor","customName":true,"deviceType":"Inertial","deviceClass":"inertial","setting":{},"triportSourcePort":22},{"port":[8],"name":"gripper_motor","customName":true,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"false","fwd":"forward","rev":"reverse","gear":"ratio18_1"},"triportSourcePort":22},{"port":[],"name":"controller_1","customName":false,"deviceType":"Controller","deviceClass":"controller","setting":{"left":"","leftDir":"false","right":"","rightDir":"false","upDown":"arm_motor","upDownDir":"false","xB":"gripper_motor","xBDir":"false","drive":"none","id":"primary"},"triportSourcePort":22},{"port":[6],"name":"bump_left","customName":true,"deviceType":"Bumper","deviceClass":"bumper","setting":{"id":"partner"},"triportSourcePort":22},{"port":[7,8],"name":"range_finder_right","customName":true,"deviceType":"RangeFinder","deviceClass":"sonar","setting":{"id":"partner"},"triportSourcePort":22},{"port":[5],"name":"bump_right","customName":true,"deviceType":"Bumper","deviceClass":"bumper","setting":{"id":"partner"},"triportSourcePort":22}],"slot":0,"platform":"V5","sdkVersion":"20240802.15.00.00","appVersion":"4.64.0","fileFormat":"2.0.0","targetBrainGen":"First","v5Sounds":[{"name":"game over","url":"static/sounds/mixkit-arcade-retro-game-over-213.wav"}],"v5SoundsEnabled":false,"aiVisionSettings":{"colors":[],"codes":[],"tags":true,"AIObjects":true,"AIObjectModel":[],"aiModelDropDownValue":null}}