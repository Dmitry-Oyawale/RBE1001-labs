{"mode":"Text","hardwareTarget":"brain","textContent":"#region VEXcode Generated Robot Configuration\nfrom vex import *\nimport urandom\nimport math\n\n# Brain should be defined by default\nbrain=Brain()\n\n# Robot configuration code\nright_motor = Motor(Ports.PORT1, GearSetting.RATIO_18_1, False)\nleft_motor = Motor(Ports.PORT2, GearSetting.RATIO_18_1, True)\nline_tracker_right = Line(brain.three_wire_port.a)\nline_tracker_left = Line(brain.three_wire_port.b)\nrange_finder = Sonar(brain.three_wire_port.c)\n# AI Vision Color Descriptions\nai_vision_9__GREEN_Fr = Colordesc(1, 51, 207, 100, 23, 0.64)\n# AI Vision Code Descriptions\nai_vision_9 = AiVision(Ports.PORT9, ai_vision_9__GREEN_Fr)\narm_motor = Motor(Ports.PORT3, GearSetting.RATIO_18_1, True)\ninertial_sensor = Inertial(Ports.PORT13)\ngripper_motor = Motor(Ports.PORT8, GearSetting.RATIO_18_1, False)\n\n\n# wait for rotation sensor to fully initialize\nwait(30, MSEC)\n\n\n# Make random actually random\ndef initializeRandomSeed():\n    wait(100, MSEC)\n    random = brain.battery.voltage(MV) + brain.battery.current(CurrentUnits.AMP) * 100 + brain.timer.system_high_res()\n    urandom.seed(int(random))\n      \n# Set random seed \ninitializeRandomSeed()\n\n\ndef play_vexcode_sound(sound_name):\n    # Helper to make playing sounds from the V5 in VEXcode easier and\n    # keeps the code cleaner by making it clear what is happening.\n    print(\"VEXPlaySound:\" + sound_name)\n    wait(5, MSEC)\n\n# add a small delay to make sure we don't print in the middle of the REPL header\nwait(200, MSEC)\n# clear the console to make sure we don't have the REPL in the console\nprint(\"\\033[2J\")\n\n#endregion VEXcode Generated Robot Configuration\n\n# ------------------------------------------\n# \n# \tProject:      VEXcode Project\n#\tAuthor:       VEX\n#\tCreated:\n#\tDescription:  VEXcode V5 Python Project\n# \n# ------------------------------------------\n\n# Library imports\nfrom vex import *\nIDLE = -1\nDRIVING_UP_RAMP = 0\nLOOKING_FOR_FRUIT = 1\nPICKING_FRUIT = 2\nHOLDING_FRUIT = 3\nDELIVERING_FRUIT = 3\nDRIVNG_DOWN_RAMP = 4\nDRIVING_TO_BAR = 6\nHANGING = 7\n\nGRIPPER_OPEN = 8\nGRIPPER_CLOSED = 9\n\nstate = IDLE\ngripper_state = GRIPPER_CLOSED\nobjects = ai_vision_9.take_snapshot(ai_vision_9__GREEN_Fr)\n\ncenterX = 160\ntargetY = 10\nfruitHeightPixels = 140\nfruitWidthPixels = 65\n\nKp_angle = 1\nKp_distance = 0.5\n\nwheelDiameter = 4.25\nwheelCircumference = math.pi * wheelDiameter\ngearRatio = 5.0\nKp = 20\n\ndef driveStraight(motorVoltage, distanceInInches):\n    distanceDriven = 0.0\n\n    while (True):\n        if (distanceDriven > distanceInInches):\n            break\n    \n        leftPosition, rightPosition = left_motor.position(TURNS), right_motor.position(TURNS)\n        avgPosition = (leftPosition + rightPosition)/2\n        \n        error = leftPosition - rightPosition\n        left_voltage = max(-12, min(motorVoltage - Kp * error, 12))\n        right_voltage = max(-12, min(motorVoltage + Kp * error, 12))\n        distanceDriven = (avgPosition/gearRatio) * wheelCircumference\n\n        left_motor.spin(FORWARD, left_voltage, VOLT)\n        right_motor.spin(FORWARD, right_voltage, VOLT)\n        wait(10, MSEC)\n    left_motor.stop()\n    right_motor.stop()\n\ndef drive(speed, direction):\n   left_motor.set_velocity(speed + direction, RPM)\n   right_motor.set_velocity(speed - direction, RPM)\n   left_motor.spin(FORWARD)\n   right_motor.spin(FORWARD)\n\ndef trackLine():\n    left_percent, right_percent = line_tracker_left.reflectivity(PERCENT), line_tracker_right.reflectivity(PERCENT)\n    if (left_percent < 40 and right_percent < 40): # both line trackers are on a line so turn 90 degrees\n        turn_in_place(90)\n    elif (left_percent < 40):\n        drive(150, 10)\n    elif (right_percent < 40):\n        drive(150, -10)\n    else:\n        drive(150, 0)\n\ndef stop_robot():\n    left_motor.stop()\n    right_motor.stop()\n\ndef turn_in_place(angleDegrees):\n    global Kp_angle\n    initialHeading = inertial_sensor.heading(DEGREES) #inertial_sensor.heading(DEGREES) if inertial_sensor.heading(DEGREES) <= 180 else 360 - inertial_sensor.heading(DEGREES)\n    finalHeading = (initialHeading + angleDegrees) % 360\n    print(\"Final heading: \", finalHeading)\n    print(\"Initial heading: \", initialHeading)\n    currentHeading = initialHeading\n    wait(10, MSEC)\n    while (True):\n        currentHeading = inertial_sensor.heading(DEGREES) #inertial_sensor.heading(DEGREES) if inertial_sensor.heading(DEGREES) <= 180 else 360 - inertial_sensor.heading(DEGREES)\n        error = ((currentHeading - finalHeading + 180) % 360) - 180\n        print(\"Current heading: \", currentHeading)\n        print(\"Error: \", error)\n        if (math.fabs(error) < 1):\n            break\n        left_voltage = max(-6, min(Kp_angle * error, 6))\n        right_voltage = max(-6, min(Kp_angle * error, 6))\n        left_motor.spin(FORWARD, left_voltage, VOLT)\n        right_motor.spin(REVERSE, right_voltage, VOLT)\n        wait(10, MSEC)\n\ndef get_objects():\n    return ai_vision_9.take_snapshot(ai_vision_9__GREEN_Fr)\n\nSEARCH_TARGET_Y = 120    # center of frame, use this when fruit is far\nAPPROACH_TARGET_Y = 1   # near top of frame, transition to blind grab here\n\ndef adjust_arm():\n    global objects, HOLDING_FRUIT, state\n    objects = ai_vision_9.take_snapshot(ai_vision_9__GREEN_Fr)\n    if (state == HOLDING_FRUIT):\n        return\n    if objects[0].exists:\n        open_gripper()\n        fruit = objects[0]\n        print(\"object detected\")\n        if fruit.centerY > APPROACH_TARGET_Y and not check_arm_outside_bounds() and fruit.height < 65:\n            # Fruit still visible and not near top — normal tracking\n            angleError = fruit.centerY - targetY\n            velocity = Kp_angle * angleError * 6\n            arm_motor.set_velocity(velocity, RPM)\n            arm_motor.spin(FORWARD)\n            \n        else:\n            # Fruit near top of frame — gripper is close\n            # Stop adjusting, trust your last position and grab\n            arm_motor.stop()\n    else:\n        print(\"Object not deteced\")\n        # Fruit not visible at all — two possibilities:\n        if check_arm_outside_bounds():     # check arm encoder position\n            arm_motor.stop()\n            move_arm_to_bounds()\n            close_gripper()\n            state = HOLDING_FRUIT\n        else:\n            arm_motor.stop()      # lost track entirely, don't guess\n            close_gripper()\n            state = HOLDING_FRUIT\n\n\n\ndef check_arm_outside_bounds():\n    return arm_motor.position(TURNS) < -7 or arm_motor.position(TURNS) > 0.3\ndef move_arm_to_bounds():\n    if (arm_motor.position(TURNS) < -7):\n        arm_motor.spin_to_position(-4.9,TURNS,wait=True)\n    else:\n         arm_motor.spin_to_position(-0.1,TURNS,wait=True)\n\n\ndef drive_to_fruit():\n    global objects, centerX, Kp_distance, centerY, fruitWidthPixels\n    objects = ai_vision_9.take_snapshot(ai_vision_9__GREEN_Fr)\n    if (objects[0].exists == True):\n        fruit = objects[0]\n        if (fruit.width < 100):\n            angleError = fruit.centerX - centerX\n            distanceError = fruit.width - fruitWidthPixels\n            drive(100 - (Kp_distance * distanceError), Kp_angle * angleError)\n            wait(50, MSEC)\n        else:\n            stop_robot()\n    else:\n        stop_robot()\n\n\ndef adjust_gripper():\n    global gripper_state, GRIPPER_CLOSED, GRIPPER_OPEN\n    if (gripper_state == GRIPPER_OPEN):\n        print(\"closing gripper\")\n        gripper_motor.spin_to_position(0,DEGREES,wait=True)\n        gripper_state = GRIPPER_CLOSED\n    else:\n        gripper_motor.spin_to_position(150,DEGREES,wait=True)\n        print(\"opening gripper\")\n        gripper_state = GRIPPER_OPEN\n\ndef open_gripper():\n    if (gripper_state == GRIPPER_CLOSED):\n        adjust_gripper()\n\ndef close_gripper():\n    if (gripper_state == GRIPPER_OPEN):\n        adjust_gripper()\n\nwhile(len(ai_vision_9.take_snapshot(ai_vision_9__GREEN_Fr)) == 0):\n    trackLine()\nopen_gripper()\narm_motor.spin_to_position(-2.5,TURNS,wait=True)\nwhile(len(ai_vision_9.take_snapshot(ai_vision_9__GREEN_Fr)) == 0):\n    trackLine()\nwhile (state != HOLDING_FRUIT):\n    adjust_arm()\n    drive_to_fruit()\nstop_robot()\narm_motor.spin_to_position(-0.5,TURNS,wait=True)\n\n# while (True):\n#     if (state == DRIVING_UP RAMP):\n#         if (math.fabs(0 - inertial_sensor.orientation(OrientationType.ROLL, DEGREES)) > 1):\n#             trackLine()\n#         else:\n#             stop()\n#             state = LOOKING_FOR_FRUIT\n    \n\n#     if (state == LOOKING_FOR_FRUIT):\n#         objects = get_objects()\n#         if (len(objects) == 0):\n#             trackLine()\n#         else:\n#             stop()\n#             state = PICKING_FRUIT\n    \n#     if (state == PICKING_FRUIT):\n\n\n","textLanguage":"python","robotConfig":[{"port":[1],"name":"right_motor","customName":true,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"false","fwd":"forward","rev":"reverse","gear":"ratio18_1"},"triportSourcePort":22},{"port":[2],"name":"left_motor","customName":true,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"true","fwd":"forward","rev":"reverse","gear":"ratio18_1"},"triportSourcePort":22},{"port":[1],"name":"line_tracker_right","customName":true,"deviceType":"LineTracker","deviceClass":"line","setting":{},"triportSourcePort":22},{"port":[2],"name":"line_tracker_left","customName":true,"deviceType":"LineTracker","deviceClass":"line","setting":{},"triportSourcePort":22},{"port":[3,4],"name":"range_finder","customName":true,"deviceType":"RangeFinder","deviceClass":"sonar","setting":{},"triportSourcePort":22},{"port":[9],"name":"ai_vision_9","customName":false,"deviceType":"AIVision","deviceClass":"aivision","setting":{"config":"{\"colors\":[{\"id\":1,\"name\":\"GREEN_Fr\",\"nameValid\":\"Valid\",\"lastValidName\":\"GREEN_Fr\",\"red\":51.351851851851855,\"green\":206.66545893719805,\"blue\":99.77334943639292,\"hueRange\":23,\"saturationRange\":0.64}],\"codes\":[],\"tags\":false,\"AIObjects\":false,\"AIObjectModel\":[\"Ball(Blue)\",\"Ball(Green)\",\"Ball(Red)\",\"Ring(Blue)\",\"Ring(Green)\",\"Ring(Red)\",\"Cube(Blue)\",\"Cube(Green)\",\"Cube(Red)\"],\"AIModelMetadata\":{\"id\":0,\"version\":1,\"name\":\"Classroom Objects\"},\"aiModelDropDownValue\":0}","isConfigured":"false"},"triportSourcePort":22},{"port":[3],"name":"arm_motor","customName":true,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"true","fwd":"forward","rev":"reverse","gear":"ratio18_1"},"triportSourcePort":22},{"port":[13],"name":"inertial_sensor","customName":true,"deviceType":"Inertial","deviceClass":"inertial","setting":{},"triportSourcePort":22},{"port":[8],"name":"gripper_motor","customName":true,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"false","fwd":"forward","rev":"reverse","gear":"ratio18_1"},"triportSourcePort":22}],"slot":0,"platform":"V5","sdkVersion":"20240802.15.00.00","appVersion":"4.64.0","fileFormat":"2.0.0","targetBrainGen":"First","v5Sounds":[{"name":"game over","url":"static/sounds/mixkit-arcade-retro-game-over-213.wav"}],"v5SoundsEnabled":false,"aiVisionSettings":{"colors":[],"codes":[],"tags":true,"AIObjects":true,"AIObjectModel":[],"aiModelDropDownValue":null}}