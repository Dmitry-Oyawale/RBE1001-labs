{"mode":"Text","hardwareTarget":"brain","textContent":"#region VEXcode Generated Robot Configuration\nfrom vex import *\nimport urandom\nimport math\n\n# Brain should be defined by default\nbrain=Brain()\n\n# Robot configuration code\nright_motor = Motor(Ports.PORT1, GearSetting.RATIO_18_1, False)\nleft_motor = Motor(Ports.PORT2, GearSetting.RATIO_18_1, False)\nline_tracker_right = Line(brain.three_wire_port.a)\nline_tracker_left = Line(brain.three_wire_port.b)\ninertial_sensor = Inertial(Ports.PORT13)\ncontroller_1 = Controller(PRIMARY)\narmMotor = Motor(Ports.PORT3, GearSetting.RATIO_18_1, False)\n\n\n# wait for rotation sensor to fully initialize\nwait(30, MSEC)\n\n\n# Make random actually random\ndef initializeRandomSeed():\n    wait(100, MSEC)\n    random = brain.battery.voltage(MV) + brain.battery.current(CurrentUnits.AMP) * 100 + brain.timer.system_high_res()\n    urandom.seed(int(random))\n      \n# Set random seed \ninitializeRandomSeed()\n\n\ndef play_vexcode_sound(sound_name):\n    # Helper to make playing sounds from the V5 in VEXcode easier and\n    # keeps the code cleaner by making it clear what is happening.\n    print(\"VEXPlaySound:\" + sound_name)\n    wait(5, MSEC)\n\n# add a small delay to make sure we don't print in the middle of the REPL header\nwait(200, MSEC)\n# clear the console to make sure we don't have the REPL in the console\nprint(\"\\033[2J\")\n\n#endregion VEXcode Generated Robot Configuration\n\n# ------------------------------------------\n# \n# \tProject:      VEXcode Project\n#\tAuthor:       VEX\n#\tCreated:\n#\tDescription:  VEXcode V5 Python Project\n# \n# ------------------------------------------\n\n# Library imports\nfrom vex import *\n\n# Begin project code\n\nKp_angle = 1\nKp_distance = 0.5\nKp = 10\n\nDRIVE = 0\nDESCENT = 1\nFINAL_APPROACH = 2\nHANG = 3\n\nstate = DRIVE\n\n\ndef turn_in_place_right(angleDegrees):\n    global Kp_angle\n    initialHeading = inertial_sensor.heading(DEGREES) #inertial_sensor.heading(DEGREES) if inertial_sensor.heading(DEGREES) <= 180 else 360 - inertial_sensor.heading(DEGREES)\n    finalHeading = (initialHeading + angleDegrees) % 360\n    print(\"Final heading: \", finalHeading)\n    print(\"Initial heading: \", initialHeading)\n    currentHeading = initialHeading\n    wait(10, MSEC)\n    while (True):\n        currentHeading = inertial_sensor.heading(DEGREES) #inertial_sensor.heading(DEGREES) if inertial_sensor.heading(DEGREES) <= 180 else 360 - inertial_sensor.heading(DEGREES)\n        error = ((currentHeading - finalHeading + 180) % 360) - 180\n        print(\"Current heading: \", currentHeading)\n        print(\"Error: \", error)\n        if (math.fabs(error) < 1):\n            break\n        left_voltage = max(-6, min(Kp_angle * error, 6))\n        right_voltage = max(-6, min(Kp_angle * error, 6))\n        left_motor.spin(REVERSE, left_voltage, VOLT)\n        right_motor.spin(FORWARD, right_voltage, VOLT)\n        wait(10, MSEC)\n\n\n\ndef drive(speed, direction):\n   left_motor.set_velocity(speed + direction, RPM)\n   right_motor.set_velocity(speed - direction, RPM)\n   left_motor.spin(FORWARD)\n   right_motor.spin(FORWARD)\n\n\ndef trackLine2(): #On platform to bottom of ramp\n    left_percent, right_percent = line_tracker_left.reflectivity(PERCENT), line_tracker_right.reflectivity(PERCENT)\n    if (left_percent < 40 and right_percent < 40 and state == DRIVE): # both line trackers are on a line so turn 90 degrees\n        turn_in_place_right(90)\n    elif (left_percent < 40):\n        drive(150, 10)\n    elif (right_percent < 40):\n        drive(150, -10)\n    else:\n        drive(150, 0)\n\n\n\n\n\n\ndef handleLeft1Button():\n    global state\n    state = HANG\n\ncontroller_1.buttonL1.pressed(handleLeft1Button)\n\ndef trackLine3(): #At bottom of ramp to bar\n    left_percent, right_percent = line_tracker_left.reflectivity(PERCENT), line_tracker_right.reflectivity(PERCENT)\n    if (left_percent < 40):\n        drive(40, 50)\n    elif (right_percent < 40):\n        drive(40, -50)\n    else:\n        drive(150, 0)\n\ninertial_sensor.set_rotation(0, DEGREES)\nwhile(state == DRIVE or state == DESCENT):\n    trackLine2()\n    if(inertial_sensor.heading(DEGREES) > 90):\n        state = DESCENT\n    if(inertial_sensor.heading(DEGREES) < 50 and state == DESCENT):\n        state = FINAL_APPROACH\n\nwhile(state == FINAL_APPROACH):\n    trackLine3()\n\nleft_motor.stop()\nright_motor.stop()\narmMotor.spin_for(FORWARD, 2600, DEGREES, wait=True)\nleft_motor.spin_for(REVERSE, 1000, DEGREES, wait=False)\nright_motor.spin_for(REVERSE, 1000, DEGREES, wait=True)\narmMotor.spin_for(REVERSE, 2600, DEGREES, wait=False)\nleft_motor.spin_for(REVERSE, 500, DEGREES, wait=False)\nright_motor.spin_for(REVERSE, 500, DEGREES, wait=False)","textLanguage":"python","robotConfig":[{"port":[1],"name":"right_motor","customName":true,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"false","fwd":"forward","rev":"reverse","gear":"ratio18_1"},"triportSourcePort":22},{"port":[2],"name":"left_motor","customName":true,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"false","fwd":"forward","rev":"reverse","gear":"ratio18_1"},"triportSourcePort":22},{"port":[1],"name":"line_tracker_right","customName":true,"deviceType":"LineTracker","deviceClass":"line","setting":{},"triportSourcePort":22},{"port":[2],"name":"line_tracker_left","customName":true,"deviceType":"LineTracker","deviceClass":"line","setting":{},"triportSourcePort":22},{"port":[13],"name":"inertial_sensor","customName":true,"deviceType":"Inertial","deviceClass":"inertial","setting":{}},{"port":[],"name":"controller_1","customName":false,"deviceType":"Controller","deviceClass":"controller","setting":{"left":"","leftDir":"false","right":"","rightDir":"false","upDown":"","upDownDir":"false","xB":"","xBDir":"false","drive":"none","id":"primary"}},{"port":[3],"name":"armMotor","customName":true,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"false","fwd":"forward","rev":"reverse","gear":"ratio18_1","id":"partner"}}],"slot":0,"platform":"V5","sdkVersion":"20240802.15.00.00","appVersion":"4.64.0","fileFormat":"2.0.0","targetBrainGen":"First","v5Sounds":[{"name":"game over","url":"static/sounds/mixkit-arcade-retro-game-over-213.wav"}],"v5SoundsEnabled":false,"aiVisionSettings":{"colors":[],"codes":[],"tags":true,"AIObjects":true,"AIObjectModel":[],"aiModelDropDownValue":null}}