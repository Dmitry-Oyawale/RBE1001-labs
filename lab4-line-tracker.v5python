{"mode":"Text","hardwareTarget":"brain","textContent":"#region VEXcode Generated Robot Configuration\nfrom vex import *\nimport urandom\nimport math\n\n# Brain should be defined by default\nbrain=Brain()\n\n# Robot configuration code\nright_motor = Motor(Ports.PORT1, GearSetting.RATIO_18_1, True)\nleft_motor = Motor(Ports.PORT2, GearSetting.RATIO_18_1, False)\ninertial_sensor = Inertial(Ports.PORT3)\nrightSensor = Line(brain.three_wire_port.a)\nleftSensor = Line(brain.three_wire_port.b)\nrange_finder = Sonar(brain.three_wire_port.c)\n# AI Vision Color Descriptions\nai_vision_15__COLOR1 = Colordesc(1, 114, 62, 153, 14, 0.29)\n# AI Vision Code Descriptions\nai_vision_15 = AiVision(Ports.PORT15, ai_vision_15__COLOR1)\n\n\n# wait for rotation sensor to fully initialize\nwait(30, MSEC)\n\n\n# Make random actually random\ndef initializeRandomSeed():\n    wait(100, MSEC)\n    random = brain.battery.voltage(MV) + brain.battery.current(CurrentUnits.AMP) * 100 + brain.timer.system_high_res()\n    urandom.seed(int(random))\n      \n# Set random seed \ninitializeRandomSeed()\n\n\ndef play_vexcode_sound(sound_name):\n    # Helper to make playing sounds from the V5 in VEXcode easier and\n    # keeps the code cleaner by making it clear what is happening.\n    print(\"VEXPlaySound:\" + sound_name)\n    wait(5, MSEC)\n\n# add a small delay to make sure we don't print in the middle of the REPL header\nwait(200, MSEC)\n# clear the console to make sure we don't have the REPL in the console\nprint(\"\\033[2J\")\n\n#endregion VEXcode Generated Robot Configuration\n\n# ------------------------------------------\n# \n# \tProject:      VEXcode Project\n#\tAuthor:       VEX\n#\tCreated:\n#\tDescription:  VEXcode V5 Python Project\n# \n# ------------------------------------------\n\n# Library imports\nfrom vex import *\n\nKp_angle = 1\nKp_distance = 1\ncenterDistanceInches = 4\n\ncenterX = 160\nfruitHeightPixels = 150\n\nobjects = ai_vision_15.take_snapshot(ai_vision_15__COLOR1)\n\n# Begin project code\ndef drive(speed, direction):\n   left_motor.set_velocity(speed + direction, RPM)\n   right_motor.set_velocity(speed - direction, RPM)\n   left_motor.spin(REVERSE)\n   right_motor.spin(REVERSE)\n\ndef trackLine():\n    if (leftSensor.reflectivity(PERCENT) < 40):\n        drive(150, 10)\n    elif (rightSensor.reflectivity(PERCENT) < 40):\n        drive(150, -10)\n    else:\n        drive(150, 0)\n\ndef turn_in_place(angleDegrees):\n    global Kp_angle\n    initialHeading = inertial_sensor.heading(DEGREES) #inertial_sensor.heading(DEGREES) if inertial_sensor.heading(DEGREES) <= 180 else 360 - inertial_sensor.heading(DEGREES)\n    finalHeading = (initialHeading + angleDegrees) % 360\n    print(\"Final heading: \", finalHeading)\n    print(\"Initial heading: \", initialHeading)\n    currentHeading = initialHeading\n    wait(10, MSEC)\n    while (True):\n        currentHeading = inertial_sensor.heading(DEGREES) #inertial_sensor.heading(DEGREES) if inertial_sensor.heading(DEGREES) <= 180 else 360 - inertial_sensor.heading(DEGREES)\n        error = ((currentHeading - finalHeading + 180) % 360) - 180\n        print(\"Current heading: \", currentHeading)\n        print(\"Error: \", error)\n        if (math.fabs(error) < 1):\n            break\n        left_voltage = max(-6, min(Kp_angle * error, 6))\n        right_voltage = max(-6, min(Kp_angle * error, 6))\n        left_motor.spin(FORWARD, left_voltage, VOLT)\n        right_motor.spin(REVERSE, right_voltage, VOLT)\n        wait(10, MSEC)\n\ndef getObjects():\n    return ai_vision_15.take_snapshot(ai_vision_15__COLOR1)\n\ndef detectObject():\n    global objects\n  # takes a snapshot and searches for Orange_Fr\n  # you’ll want to use the signature that you defined above\n\n    objects = ai_vision_15.take_snapshot(ai_vision_15__COLOR1)\n\n    # print the coordinates of the center of the object\n    if (objects[0].exists == True):\n        print(\"object detected\")\n        global centerX, fruitHeightPixels, Kp_angle, Kp_distance\n        fruit = objects[0]\n        angleError = fruit.centerX - centerX\n        distanceError = fruitHeightPixels - fruit.height\n        print(\"Angle error: \", angleError, \" Speed: \", Kp_distance * distanceError * 1)\n        print(\"Distance error: \", distanceError, \" Direction: \", Kp_angle * angleError)\n        drive(Kp_distance * distanceError, Kp_angle * angleError)\n        wait(90, MSEC)\n        return True\n    else:\n        print(\"Could not find tag\")\n        left_motor.stop()\n        right_motor.stop()\n        return False\n\nwait(5, SECONDS)\ndrive(150, 0)\nwait(2, SECONDS)\nwhile (math.fabs(0 - inertial_sensor.orientation(OrientationType.ROLL, DEGREES)) > 1):\n    distance = range_finder.distance(INCHES)\n    error = distance - centerDistanceInches\n    drive(150, Kp_distance*error)\n    wait(40, MSEC)\ndrive(150, 0)\nwait(2,SECONDS)\nturn_in_place(-90)\ndrive(150, 0)\nwait(3.2, SECONDS)\n\nwhile(len(getObjects()) == 0):\n    trackLine()\n    wait(10, MSEC)\n\nwhile(len(getObjects()) >= 1):\n    detectObject()    \n\n\n\n","textLanguage":"python","robotConfig":[{"port":[1],"name":"right_motor","customName":true,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"true","fwd":"forward","rev":"reverse","gear":"ratio18_1"},"triportSourcePort":22},{"port":[2],"name":"left_motor","customName":true,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"false","fwd":"forward","rev":"reverse","gear":"ratio18_1"},"triportSourcePort":22},{"port":[3],"name":"inertial_sensor","customName":true,"deviceType":"Inertial","deviceClass":"inertial","setting":{},"triportSourcePort":22},{"port":[1],"name":"rightSensor","customName":true,"deviceType":"LineTracker","deviceClass":"line","setting":{},"triportSourcePort":22},{"port":[2],"name":"leftSensor","customName":true,"deviceType":"LineTracker","deviceClass":"line","setting":{},"triportSourcePort":22},{"port":[3,4],"name":"range_finder","customName":true,"deviceType":"RangeFinder","deviceClass":"sonar","setting":{},"triportSourcePort":22},{"port":[15],"name":"ai_vision_15","customName":false,"deviceType":"AIVision","deviceClass":"aivision","setting":{"config":"{\"colors\":[{\"id\":1,\"name\":\"COLOR1\",\"nameValid\":\"Valid\",\"lastValidName\":\"COLOR1\",\"red\":114.37525252525252,\"green\":61.71022727272727,\"blue\":152.69444444444446,\"hueRange\":14,\"saturationRange\":0.29}],\"codes\":[],\"tags\":false,\"AIObjects\":false,\"AIObjectModel\":[\"Ball(Blue)\",\"Ball(Green)\",\"Ball(Red)\",\"Ring(Blue)\",\"Ring(Green)\",\"Ring(Red)\",\"Cube(Blue)\",\"Cube(Green)\",\"Cube(Red)\"],\"AIModelMetadata\":{\"id\":0,\"version\":1,\"name\":\"Classroom Objects\"},\"aiModelDropDownValue\":0}","isConfigured":"false"},"triportSourcePort":22}],"slot":0,"platform":"V5","sdkVersion":"20240802.15.00.00","appVersion":"4.64.0","fileFormat":"2.0.0","targetBrainGen":"First","v5Sounds":[{"name":"game over","url":"static/sounds/mixkit-arcade-retro-game-over-213.wav"}],"v5SoundsEnabled":false,"aiVisionSettings":{"colors":[],"codes":[],"tags":true,"AIObjects":true,"AIObjectModel":[],"aiModelDropDownValue":null}}